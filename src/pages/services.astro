---
import Layout from "../layouts/Layout.astro";
---
<Layout
  title="Happy Feet Spa — Services"
  description="Full menu of massage, foot reflexology, and TCM therapy services with pricing."
  activeNav="services"
>
  <main>
    <!-- PAGE INTRO -->
    <section class="hero">
      <div class="wrap intro-grid">
        <div>
          <p class="eyebrow">Full Menu</p>
          <h1>Services &amp; Pricing</h1>
          <p class="lead">Every treatment we offer, with exact pricing. Walk-ins welcome based on availability &mdash; call ahead to secure your spot.</p>
          <div class="hero-actions">
            <a class="btn btn-ember" href="tel:+18165233338">
              Call to book
              <span class="pip" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none"><path d="M4 8h8M8 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            </a>
            <a class="btn btn-ghost" href="/#top">Back to home</a>
          </div>
        </div>
        <img class="intro-photo" src="/images/treatment-room.jpg" alt="Treatment room at Happy Feet Spa" />
      </div>
    </section>

    <!-- SERVICE LIST -->
    <section aria-labelledby="svc-h">
      <div class="wrap">
        <div class="sec-head reveal">
          <p class="eyebrow">The full list</p>
          <h2 id="svc-h">Nine services, three focuses.</h2>
        </div>

        <div class="svc-list">
          <div class="svc-cat reveal">
            <h2>Foot Reflexology</h2>
            <div class="svc-cat-list">

              <div class="svc svc--photo">
                <img class="svc-thumb" src="/images/foot-massage.avif" alt="Foot massage" />
                <div>
                  <div class="svc-name"><h3>Foot Massage</h3></div>
                  <p class="svc-desc">Precisely targets foot reflex zones to regulate organs and blood flow, easing fatigue from standing or walking.</p>
                </div>
                <div class="svc-prices">
                  <div class="price-row"><span class="dur">30 min</span><span class="dots"></span><span class="price">$35</span></div>
                  <div class="price-row"><span class="dur">60 min</span><span class="dots"></span><span class="price">$60</span></div>
                </div>
              </div>

              <div class="svc svc--photo">
                <img class="svc-thumb" src="/images/hand-foot-massage.avif" alt="Hand and foot massage" />
                <div>
                  <div class="svc-name"><h3>Hand &amp; Foot Massage</h3><span class="svc-tag">Most Popular</span></div>
                  <p class="svc-desc">A focused massage for hands and feet using reflexology techniques to stimulate pressure points, improve energy flow, and relieve daily fatigue.</p>
                </div>
                <div class="svc-prices">
                  <div class="price-row"><span class="dur">75 min</span><span class="dots"></span><span class="price">$65</span></div>
                </div>
              </div>

              <div class="svc svc--photo">
                <img class="svc-thumb" src="/images/body-foot-combo.avif" alt="Body and foot combo massage" />
                <div>
                  <div class="svc-name"><h3>Body &amp; Foot Combo</h3></div>
                  <p class="svc-desc">A combined service that includes both body massage and foot reflexology in one session.</p>
                </div>
                <div class="svc-prices">
                  <div class="price-row"><span class="dur">40 min</span><span class="dots"></span><span class="price">$50</span></div>
                  <div class="price-row"><span class="dur">60 min</span><span class="dots"></span><span class="price">$70</span></div>
                </div>
              </div>

            </div>
          </div>

          <div class="svc-cat reveal">
            <h2>Body &amp; Head Massage</h2>
            <div class="svc-cat-list">

              <div class="svc svc--photo">
                <img class="svc-thumb" src="/images/body-massage.avif" alt="Body massage" />
                <div>
                  <div class="svc-name"><h3>Body Massage</h3></div>
                  <p class="svc-desc">Relax your entire body with a full-body massage designed to reduce stress, release muscle tension, and improve circulation.</p>
                </div>
                <div class="svc-prices">
                  <div class="price-row"><span class="dur">60 min</span><span class="dots"></span><span class="price">$85</span></div>
                  <div class="price-row"><span class="dur">75 min</span><span class="dots"></span><span class="price">$105</span></div>
                  <div class="price-row"><span class="dur">90 min</span><span class="dots"></span><span class="price">$120</span></div>
                </div>
              </div>

              <div class="svc svc--photo">
                <img class="svc-thumb" src="/images/head-massage.avif" alt="Head massage" />
                <div>
                  <div class="svc-name"><h3>Head Massage</h3></div>
                  <p class="svc-desc">A soothing head and scalp massage designed to relieve mental stress, reduce headaches, and improve relaxation and sleep quality.</p>
                </div>
                <div class="svc-prices">
                  <div class="price-row"><span class="dur">60 min</span><span class="dots"></span><span class="price">$85</span></div>
                </div>
              </div>

              <div class="svc svc--photo">
                <img class="svc-thumb" src="/images/head-neck-release.avif" alt="Head and neck release massage" />
                <div>
                  <div class="svc-name"><h3>Head &amp; Neck Release</h3></div>
                  <p class="svc-desc">Designed for high-pressure lifestyles to relieve tension headaches, improve sleep, and release stress.</p>
                </div>
                <div class="svc-prices">
                  <div class="price-row"><span class="dur">60 min</span><span class="dots"></span><span class="price">$85</span></div>
                </div>
              </div>

              <div class="svc svc--photo">
                <img class="svc-thumb" src="/images/hand-massage.avif" alt="Hand massage" />
                <div>
                  <div class="svc-name"><h3>Hand Massage</h3></div>
                  <p class="svc-desc">Gentle care for tired hands and arms using acupressure to improve flexibility and reduce soreness.</p>
                </div>
                <div class="svc-prices">
                  <div class="price-row"><span class="dur">10 min</span><span class="dots"></span><span class="price">$15</span></div>
                  <div class="price-row"><span class="dur">20 min</span><span class="dots"></span><span class="price">$25</span></div>
                </div>
              </div>

              <div class="svc svc--photo">
                <img class="svc-thumb" src="/images/chair-massage.avif" alt="Chair massage, back focus" />
                <div>
                  <div class="svc-name"><h3>Chair Massage</h3><span class="svc-tag">Back Focus</span></div>
                  <p class="svc-desc">A quick and effective seated massage targeting the neck, shoulders, and back.</p>
                </div>
                <div class="svc-prices">
                  <div class="price-row"><span class="dur">10 min</span><span class="dots"></span><span class="price">$20</span></div>
                  <div class="price-row"><span class="dur">20 min</span><span class="dots"></span><span class="price">$30</span></div>
                  <div class="price-row"><span class="dur">30 min</span><span class="dots"></span><span class="price">$40</span></div>
                </div>
              </div>

            </div>
          </div>

          <div class="svc-cat reveal">
            <h2>TCM Therapy</h2>
            <div class="svc-cat-list">

              <div class="svc svc--photo">
                <img class="svc-thumb" src="/images/tcm-therapy.avif" alt="TCM therapy session" />
                <div>
                  <div class="svc-name"><h3>TCM Therapy</h3></div>
                  <p class="svc-desc">Traditional Chinese Medicine therapy using cupping and moxibustion techniques to improve blood circulation.</p>
                </div>
                <div class="svc-prices">
                  <div class="price-row"><span class="dur">60 min</span><span class="dots"></span><span class="price">$95</span></div>
                  <div class="price-row"><span class="dur">75 min</span><span class="dots"></span><span class="price">$115</span></div>
                  <div class="price-row"><span class="dur">90 min</span><span class="dots"></span><span class="price">$135</span></div>
                </div>
              </div>

            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-band">
      <div class="wrap">
        <p class="eyebrow">Ready when you are</p>
        <h2>Walk in, or call ahead.</h2>
        <p class="lead">Walk-ins welcome based on availability. Phone bookings recommended to secure your spot.</p>
        <div class="hero-actions">
          <a class="btn btn-ember" href="tel:+18165233338">
            Call (816) 523-3338
            <span class="pip" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none"><path d="M4 8h8M8 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <style>
    /* ---------- Page intro (light band) ---------- */
    .hero {
      background: var(--hero-bg);
      color: var(--ink);
      border-bottom: 1px solid var(--line);
      padding-top: calc(var(--step) + 3.2rem);
      padding-bottom: clamp(2.5rem, 5vw, 3.5rem);
    }
    .hero h1 {
      font-size: clamp(2.3rem, 5vw, 3.4rem);
      font-weight: 400;
      letter-spacing: -.01em;
      margin: 0 0 1rem;
    }
    .hero .eyebrow { color: var(--ember); }
    .hero .lead { color: var(--ink-soft); }
    .hero-actions { display: flex; flex-wrap: wrap; gap: .9rem; margin-top: 1.8rem; }
    .hero .btn-ghost { color: var(--ink); }

    .intro-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
    .intro-photo {
      width: 100%; height: clamp(200px, 26vw, 300px);
      object-fit: cover; object-position: center 30%;
      border-radius: 18px; border: 1px solid var(--line);
      display: block;
    }

    /* ---------- Service listing ---------- */
    .svc-list { display: grid; gap: clamp(3.2rem, 6vw, 4.5rem); }
    .svc-cat > h2 {
      font-family: var(--f-mono);
      font-weight: 500;
      font-size: .82rem;
      letter-spacing: .2em;
      text-transform: uppercase;
      color: var(--ink);
      padding-bottom: .9rem;
      border-bottom: 2px solid var(--ink);
    }
    .svc-cat-list { display: grid; gap: clamp(1.8rem, 3vw, 2.4rem); margin-top: 2rem; }
    .svc {
      display: grid;
      grid-template-columns: 1.3fr .95fr;
      gap: 1.4rem 3rem;
      align-items: start;
      padding-top: 1.6rem;
      border-top: 1px solid var(--line);
    }
    .svc:first-child { padding-top: 0; border-top: none; }
    .svc-name { display: flex; align-items: baseline; gap: .65rem; flex-wrap: wrap; }
    .svc-name h3 { font-size: 1.32rem; }
    .svc-tag {
      font-family: var(--f-mono);
      font-size: .64rem;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--ember);
      border: 1px solid var(--ember);
      border-radius: 999px;
      padding: .18rem .6rem;
      white-space: nowrap;
    }
    .svc-desc { color: var(--ink-soft); margin-top: .55rem; font-size: .98rem; max-width: 50ch; }
    .svc-prices { display: grid; gap: .5rem; align-content: start; }
    .price-row {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: baseline;
      gap: .6rem;
    }
    .price-row .dur { font-family: var(--f-mono); font-size: .92rem; color: var(--ink); white-space: nowrap; }
    .price-row .dots { border-bottom: 1px dotted var(--line); transform: translateY(-.3rem); }
    .price-row .price { font-family: var(--f-mono); font-size: 1.02rem; color: var(--ember); font-variant-numeric: tabular-nums; white-space: nowrap; }

    .svc--photo { grid-template-columns: 84px 1.25fr .95fr; }
    .svc-thumb {
      width: 84px; height: 84px;
      object-fit: cover; border-radius: 14px;
      border: 1px solid var(--line);
      display: block;
    }

    /* ---------- CTA band ---------- */
    .cta-band { background: var(--surface); border-block: 1px solid var(--line); text-align: center; }
    .cta-band .lead { margin-inline: auto; }
    .cta-band .hero-actions { justify-content: center; }

    /* ---------- Responsive ---------- */
    @media (max-width: 860px) {
      .intro-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 720px) {
      .svc, .svc--photo { grid-template-columns: 1fr; }
      .svc-thumb { width: 100%; height: 160px; border-radius: 14px; }
    }
  </style>
</Layout>
